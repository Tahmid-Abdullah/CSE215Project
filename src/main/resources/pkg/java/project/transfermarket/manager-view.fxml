<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="pkg.java.project.transfermarket.UI.ManagerController"
            style="-fx-background-color: #f0f0f0;">

    <top>
        <VBox style="-fx-background-color: #16a34a; -fx-padding: 15;">
            <Label fx:id="managerTitle" text="Manager Dashboard" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-min-width: 200; -fx-padding: 15;" spacing="10">
            <Label text="Manager Menu" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <Separator/>
            <Button text="1. Update Credentials" style="-fx-min-width: 180; -fx-text-alignment: left;" onAction="#onUpdateCredentials"/>
            <Button text="2. View My Team" style="-fx-min-width: 180; -fx-text-alignment: left;" onAction="#onViewMyTeam"/>
            <Button text="3. Buy Players" style="-fx-min-width: 180; -fx-text-alignment: left;" onAction="#onBuyPlayers"/>
            <Button text="4. Sell Player" style="-fx-min-width: 180; -fx-text-alignment: left;" onAction="#onSellPlayer"/>
            <Button text="5. Compare Players" style="-fx-min-width: 180; -fx-text-alignment: left;" onAction="#onComparePlayers"/>
            <Separator/>
            <Button text="Logout" style="-fx-min-width: 180;" onAction="#onLogout" styleClass="btn-danger"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox fx:id="contentArea" spacing="15" style="-fx-padding: 20;">
                <Label text="Select an option from the menu" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <TextArea fx:id="outputArea" wrapText="true" style="-fx-control-inner-background: white; -fx-font-size: 11;" prefHeight="450"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox style="-fx-background-color: #e5e7eb; -fx-padding: 10;">
            <Label text="Manager Panel" style="-fx-text-alignment: center; -fx-font-size: 11;"/>
        </VBox>
    </bottom>
</BorderPane>

